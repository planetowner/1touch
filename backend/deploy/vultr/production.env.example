API_DOMAIN=api.1touch.football
RELEASE_TAG=SET_BY_DEPLOYMENT
COLLAB_USER=developer
# 배포 중 직접 입력한 접근 암호를 해시로 변환해 저장해요. SSH나 DB 암호를 쓰지 않아요.
COLLAB_PASSWORD_HASH='SET_BY_DEPLOYMENT'
# Flutter Web을 사용할 때 실제 Origin을 쉼표로 구분해 넣어요. 모바일 앱은 비워 두어요.
API_CORS_ORIGINS=
# 아래 값은 USER_COMMUNITY_SETUP.md에 따라 준비해요. 비밀값을 Git에 올리지 않아요.
AUTH_CODE_SECRET=
SES_SMTP_HOST=
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
SES_FROM_EMAIL=
# 실제 메일을 받을 수 있는 운영자 주소예요. SES의 이메일 피드백 전달도 활성화해요.
SES_FEEDBACK_EMAIL=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM의 줄바꿈을 \n으로 넣을 수 있어요. 실제 개인 키는 채팅에 보내지 않아요.
APPLE_PRIVATE_KEY=
APPLE_WEB_CLIENT_ID=
APPLE_REDIRECT_URI=
KAKAO_APP_ID=
# 계정 상태 변경 웹훅의 수신 앱을 대조하는 대표 REST API 키예요. Client secret·어드민 키와 달라요.
KAKAO_REST_API_KEY=
LINE_CHANNEL_ID=
# LINE Channel secret은 서버의 탈퇴 연결 해제에만 사용해요. 앱에 넣지 않아요.
LINE_CHANNEL_SECRET=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 신고 처리 권한을 줄 실제 회원 ID만 쉼표로 구분해요. 비워 두면 운영자 API는 모두 거절해요.
COMMUNITY_ADMIN_USER_IDS=
