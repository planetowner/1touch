{$API_DOMAIN} {
	encode zstd gzip
	log

	# 앱 요청은 FastAPI의 Bearer 세션으로 인증해요. 문서·운영 상태만 개발팀 암호로 보호해요.
	# 같은 Authorization 헤더에 Basic과 Bearer 인증을 동시에 요구하지 않아요.
	@protected {
		path /docs /docs/* /redoc /openapi.json /v1/ready
		not method OPTIONS
	}
	# 승인한 파일 한 개 100MB와 multipart 헤더가 들어갈 만큼만 허용해요.
	request_body {
		max_size 110MB
	}
	basic_auth @protected {
		{$COLLAB_USER} {$COLLAB_PASSWORD_HASH}
	}
	reverse_proxy api:8000
}
